{"type": "problem", "title": "\u761f\u75ab\u77f3\u677f", "extendData": "", "contentType": 2, "content": "", "vueTemplate": "\r\n<!-- n2ph-1 Puzzle -->\r\n<template>\r\n\r\n    <div class=\"vue-pz-content\">\r\n        <p>\r\n            \u2460 \u7528\u9ed1\u7ebf\u56f4\u6210\u76849\u4e2a\u65b9\u683c\u4e3a\u4e00\u4e2a\u623f\u95f4\uff0c\u75c5\u6bd2\u4e0d\u4f1a\u8de8\u623f\u95f4\u4f20\u64ad\uff0c\u3010\u533b\u751f\u3011\u4e0d\u4f1a\u8de8\u623f\u95f4\u6cbb\u7597\u3002<br />\r\n            \u2461 4\u4e3a\u3010\u60a3\u8005\u3011\uff0c\u4f1a\u5c06\u75c5\u6bd2\u4f20\u67d3\u7ed9\u5176\u4e0a\u4e0b\u5de6\u53f3\uff08\u540c\u4e00\u4e2a\u623f\u95f4\u91cc\uff09\u7684\u4eba\uff0c\u88ab\u4f20\u67d3\u8005\u82e5\u6ca1\u6709\u5728\u2462\u2463\u6761\u4e2d\u88ab\u6cbb\u6108\uff0c\u4f1a\u611f\u67d3\u5e76\u7ee7\u7eed\u6309\u6b64\u89c4\u5219\u4f20\u64ad\u75c5\u6bd2\u3002<br />\r\n            \u2462 1\u4e3a\u3010\u533b\u751f\u3011\uff0c\u53ef\u6cbb\u6108\u81ea\u5df1\u53ca\u4e0a\u4e0b\u5de6\u53f3\u7684\u4eba\uff0c\u88ab\u6cbb\u6108\u8005\u4e0d\u4f20\u64ad\u75c5\u6bd2\u3002<br />\r\n            \u2463 9\u4e3a\u3010\u81ea\u62a4\u8005\u3011\uff0c\u53ef\u6cbb\u6108\u81ea\u5df1\uff0c\u4e0d\u4f20\u64ad\u75c5\u6bd2\u3002<br />\r\n            \u2464 \u9634\u5f71\u4ee3\u8868\u75c5\u6bd2\u611f\u67d3\u8005\uff0c\u7a7a\u767d\u8868\u793a\u672a\u611f\u67d3\u75c5\u6bd2\u3002<br />\r\n            \u2465 \u6700\u7ec8\u7ed3\u679c\u7b26\u5408\u6bcf\u884c\u3001\u6bcf\u5217\u3001\u6bcf\u4e2a\u623f\u95f4\u5404\u542b1~9\u3002<br />\r\n            \u2466 \u63a8\u7406\u51fa\u6700\u7ec8\u7ed3\u679c\u540e\uff0c\u6240\u6709\u75c5\u6bd2\u5168\u90e8\u6d88\u5931\u3002\u968f\u540e5\u53d8\u6210\u3010\u60a3\u8005\u3011\uff0c3\u53d8\u6210\u3010\u533b\u751f\u3011\uff0c4\u53d8\u6210\u3010\u81ea\u62a4\u8005\u3011\uff0c\u8bf7\u63a8\u7406\u6700\u65b0\u611f\u67d3\u60c5\u51b5\u3002\r\n        </p>\r\n        <p><a href=\"https://puzz.cipherpuzzles.com/penpa-edit/#m=solve&\" target=\"_blank\">\u505a\u9898\u94fe\u63a5\uff08Penpa+\u94fe\