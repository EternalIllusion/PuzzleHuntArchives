{"type": "problem", "title": "\u5929\u7a97\u4e4b\u4e0b", "extendData": "", "contentType": 2, "content": "", "vueTemplate": "\r\n<!-- n2ph-1 Puzzle -->\r\n<template>\r\n\r\n    <div class=\"vue-pz-content\">\r\n        <img class=\"img-main-single\" :src=\"imgSource\" :alt=\"imgAlt\" />\r\n        <p>Ans:{{' _'.repeat(ansLength)}}&nbsp;&nbsp;{{' _'.repeat(ansLength-1)}}</p>\r\n    </div>\r\n    \r\n\r\n</template>\r\n\r\n<style>\r\n\r\n    .img-main-single {\r\n        width: 100%;\r\n        max-width: 100%;\r\n        height: auto;\r\n        border: #fff 3px solid;\r\n        border-radius: .5rem;\r\n    }\r\n\r\n    .vue-pz-content {\r\n        border: #bbb 3px solid;\r\n        background-color: #fff;\r\n        border-radius: 1rem;\r\n        margin: 1rem;\r\n        padding: 1.2rem;\r\n    }\r\n\r\n</style>", "vueScript": "var __vue_puzzle_component__=function(e){\"use strict\";return{setup:()=>({imgSource:e.ref(\"/config/n2ph/static/ef466582ea4441c8bc9cee8aef2f470a.webp\"),imgAlt:e.ref(\"\u5929\u7a97\u4e4b\u4e0b\"),ansLength:e.ref(5)})}}(Vue);\r\n\r\n\r\n// \u786e\u4fdd\u5bfc\u51fa\u540d\u79f0\u6b63\u786e\r\nexport default __vue_puzzle_component__;", "answer": "OASIS OMEN", "desc": "<div class=\"tip-block custom-block\">\n  <span class=\"custom-block-title\">\ud83d\udca1</span>\n  <span>\u672c\u9898\u542b\u6709\u7ebf\u4e0b\u5143\u7d20</span>\n</div>\n\n\u6bcf\u4e00\u6247\u5929\u7a97\uff0c\u90fd\u5728\u8bf4\u7740\u4ec0\u4e48\u8bed\u8a00\uff1f\n\n*\uff08\u6ce8\uff1a\u672c\u9898\u9700\u8981\u7528\u5230\u524d\u4e00\u9898\u6240\u6536\u96c6\u7684\u788e\u7247\uff09*", "tips": [{"title": "\u6211\u4eec\u6ca1\u6709\u6210\u5458\u80fd\u591f\u7ebf\u4e0b\u600e\u4e48\u529e (0\u63d0\u793a\u70b9)", "content": "\u8bf7\u8d2d\u4e70\u7b2c\u5341\u9898\u540c\u540d\u7684\u63d0\u793a\u3002\u5047\u5982\u4f60\u4e0d\u77e5\u9053\u9700\u8981\u5728\u7ebf\u4e0b\u627e\u4ec0\u4e48\uff0c\u8bf7\u8d2d\u4e70\u672c\u9898\u63d0\u793a\uff1a\u6211\u6beb\u65e0\u5934\u7eea\u3002"}, {"title": "\u6211\u6beb\u65e0\u5934\u7eea (500\u63d0\u793a\u70b9)", "content": "\u672c\u9898\u9700\u8981\u7528\u5230\u6821\u56ed\u5185\u5199\u6ee1\u5404\u56fd\u8bed\u8a00\u4e2d\u7684\u3010\u8bed\u8a00\u3011\u7684\u5929\u7a97\u3002"}, {"title": "\u6211\u5e94\u5173\u6ce8\u7b2c10\u9898\u7684\u5361\u7247\u7684\u54ea\u4e9b\u4fe1\u606f (300\u63d0\u793a\u70b9)", "content": "\u7b2c10\u9898\u5361\u7247\u4e2d\u989c\u8272\u3001\u5361\u7247\u5de6\u4e0a\u89d2\u7684\u5e8f\u53f7\u548c\u5361\u7247\u80cc\u9762\u7684\u6570\u5b57\u662f\u5c5e\u4e8e\u672c\u9898\u7684\u6761\u4ef6\u3002"}, {"title": "\u8be5\u5982\u4f55\u63d0\u53d6 (500\u63d0\u793a\u70b9)", "content": "\u627e\u5230\u989c\u8272\u6240\u5bf9\u5e94\u7684\u8bed\u8a00\u82f1\u6587\u540d\uff0c\u4f7f\u7528\u80cc\u9762\u7684\u6570\u5b57INDEX\uff08\u5373\u82e5\u84dd\u8272\u662f\u82f1\u8bed\uff0c\u80cc\u9762\u6570\u5b57\u4e3a2\uff0c\u63d0\u53d6ENGLISH\u7684\u7b2c\u4e8c\u4e2a\u5b57\u6bcdN\uff09\u6ce8\u610f\u6ca1\u6709\u767d\u8272\u7684\u8bed\u8a00\uff0c\u767d\u8272\u662f\u7a7a\u683c\u3002"}, {"title": "\u8be5\u5982\u4f55\u6392\u5e8f (300\u63d0\u793a\u70b9)", "content": "\u6309\u5de6\u4e0a\u89d2\u5e8f\u53f7\u4ece1\u81f310\u6392\u5e8f\u3002"}, {"title": "\u6211\u77e5\u9053\u6211\u8be5\u505a\u4ec0\u4e48\u4e86\uff0c\u4f46\u6211\u610f\u8bc6\u5230\u8fd9\u5bf9\u6211\u6765\u8bf4\u592a\u96be\u4e86 (1000\u63d0\u793a\u70b9)", "content": "\u4f60\u53ef\u4ee5\u53d1\u9001\u4ee5\u3010\u6211\u7684\u7eff\u732b\u5934\u9e70\u4e0a\u5929\u4e86\u3011\u5f00\u5934\u7684\u7ad9\u5185\u4fe1\uff0c\u5e76\u9644\u4e0a\u4f60\u60f3\u95ee\u7684\u4e94\u4e2a\u989c\u8272\u5bf9\u5e94\u7684\u3010\u6570\u636e\u5220\u9664\u3011\u3002\u8bf7\u60a8\u5efa\u7acb\u4e00\u5f20\u5916\u4ea4\u7528\u7684\u817e\u8baf\u6587\u6863/\u8868\u683c\u5e76\u9644\u5e26\u672c\u63d0\u793a\u7684\u89e3\u9501\u622a\u56fe\u3001\u6b64\u5904\u3010\u6570\u636e\u5220\u9664\u3011\u5bf9\u5e94\u7684\u4e1c\u897f\u3001\u4ee5\u53ca\u4f60\u4eec\u505a\u8fd9\u4e00\u9898\u7684\u8fdb\u5ea6\uff0c\u7136\u540e\u628a\u5e26\u5177\u6709\u67e5\u770b\u6743\u9650\u7684\u94fe\u63a5\u7c98\u8d34\u5230\u7ad9\u5185\u4fe1\u3002"}, {"title": "\u6211\u4eec\u77e5\u9053\u8fd9\u9053\u9898\u9700\u8981\u4ec0\u4e48\u4e86\uff0c\u4f46\u662f\u7531\u4e8e\u67d0\u4e9b\u539f\u56e0\u64cd\u4f5c\u4e0a\u6709\u56f0\u96be\u3002 (0\u63d0\u793a\u70b9)", "content": "\u8bf7\u5728\u53d1\u9001\u4ee5\u3010ABRACADABRA\u3011\u5f00\u5934\u7684\u7ad9\u5185\u4fe1\uff0c\u9644\u4e0a\u4f60\u6240\u9700\u8981\u7684\u4e1c\u897f\u7684\u540d\u5b57\u3002"}], "additionalAnswers": [{"answer": "IN THE WATER", "message": "\u51b7\u77e5\u8bc6\uff1a\u5728\u5149\u7ebf\u6bd4\u8f83\u597d\u4e14\u65e0\u98ce\u7684\u65f6\u5019\u770b\u5411\u5929\u7a97\u4e0b\u7684\u6c34\u4e2d\uff0c\u4f60\u5c06\u4f1a\u770b\u5230\u6b63\u7740\u7684\u8bed\u8a00\u4eec\u2026\u2026\u6216\u8bb8\u6ca1\u6709\u4ec0\u4e48\u7528\uff0c\u4f46\u662f\u5f88\u5e05\u4e0d\u662f\u561b:D", "extra": ""}], "links": [{"title": "\u7d22\u5f15\u9875", "type": "index", "path": "n2ph/index"}, {"title": "N2PH", "path": "/area/n2ph/2", "pgid": 2}], "arealink": {"title": "N2PH", "path": "/area/n2ph/2", "pgid": 2}}